# === GÉNÉRAL ===
APP_NAME=Flutter Template App  # Nom de l'application
APP_ENV=development             # Environnement : development | staging | production

# === API ===
API_BASE_URL=https://api.yourapp.com/api/v1  # URL de base de l'API REST
API_TIMEOUT=30000                             # Timeout des requêtes en millisecondes

# === TÉLÉMÉTRIE (OpenTelemetry) ===
# URL du collecteur OTEL (HTTP). Port 4318 standard pour HTTP/Protobuf.
OTEL_EXPORTER_OTLP_ENDPOINT=http://your-otel-collector:4318/v1/traces
API_LOGS_ENDPOINT=http://your-otel-collector:3000/api/v1/system/telemetry/logs

# === FIREBASE ===
# Ne pas mettre les clés Firebase ici.
# Configurer via google-services.json (Android) et GoogleService-Info.plist (iOS).
# Ces fichiers ne doivent PAS être commités — voir .gitignore.
